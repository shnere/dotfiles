[
    {
        "key": "alt+space",
        "command": "type",
        "when": "editorTextFocus",
        "args": {
            "text": " "
        }
    },
    {
        "key": "cmd+b",
        "command": "-workbench.action.showAllEditors"
    },
    {
        "key": "cmd+l",
        "command": "-expandLineSelection",
        "when": "editorTextFocus"
    },
    {
        "key": "cmd+j",
        "command": "-editor.action.joinLines"
    },
    {
        "key": "cmd+ç",
        "command": "editor.cpp.toggle"
    },
    {
        "key": "cmd+[Backslash]",
        "command": "workbench.action.toggleMaximizeEditorGroup",
        "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
    },
    {
        "key": "cmd+r cmd+m",
        "command": "-workbench.action.toggleMaximizeEditorGroup",
        "when": "editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups"
    },
    {
        "key": "ctrl+shift+alt+cmd+z",
        "command": "copyRelativeFilePath",
        "when": "editorFocus"
    },
    {
        "key": "cmd+r shift+alt+cmd+c",
        "command": "-copyRelativeFilePath",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+shift+alt+cmd+right",
        "command": "workbench.action.nextEditor"
    },
    {
        "key": "alt+cmd+right",
        "command": "-workbench.action.nextEditor"
    },
    {
        "key": "ctrl+pagedown",
        "command": "-workbench.action.nextEditor"
    },
    {
        "key": "ctrl+shift+alt+cmd+left",
        "command": "workbench.action.previousEditor"
    },
    {
        "key": "ctrl+alt+cmd+[Quote]",
        "command": "-workbench.action.previousEditor"
    },
    {
        "key": "alt+cmd+s",
        "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
        "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
    },
    
]
